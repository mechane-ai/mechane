{
  "path": ["packages", "lint"],
  "format": ["typescript", "javascript", "yaml", "json"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/reference.json",
    "lint/baseline/**",
    "lint/ast-grep/rules/boolean-names-tsx.yml",
    "lint/ast-grep/rules/ui-control-geometry-typescript.yml",
    "lint/ast-grep/rules/ui-visual-token-values.yml"
  ],
  "minTokens": 50,
  "minLines": 6,
  "maxLines": 1000000,
  "maxSize": "100mb",
  "threshold": 0,
  "exitCode": 1,
  "reporters": ["console"],
  "gitignore": true
}
