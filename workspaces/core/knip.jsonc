{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  // Every export of an entry file needs a consumer; `!` marks production files for `knip --production`.
  "includeEntryExports": true,
  // The public client archive consumes exports marked @public, including types its generated declarations must name. Keep this tag limited to the actual public archive surface.
  "tags": ["-public"],
  // A stale ignore entry or entry pattern is a suppression that suppresses nothing, so it fails the check.
  "treatConfigHintsAsErrors": true,
  // A type that an exported declaration's signature uses counts as used by that declaration's consumers.
  "ignoreExportsUsedInFile": { "type": true, "interface": true },
  // dependency-cruiser loads swc to parse TypeScript, as .dependency-cruiser.cjs selects with `parser: 'swc'`; the
  // Workers runtime provides `cloudflare:workers`, which no package installs.
  "ignoreDependencies": ["@swc/core", "cloudflare"],
  // The checks program loads the cruiser's configuration through dependency-cruiser's API, which knip cannot see,
  // since the root that holds it holds no source.
  "ignore": [".dependency-cruiser.cjs"],
  // The catalog workspace is development tooling. The ordinary run checks its exports and dependencies; production browser imports are forbidden by contract 075.
  "ignoreWorkspaces": ["packages/browser/catalog!"],
  // Storybook consumes CSF metadata and story exports through discovery; private production exports remain checked.
  // Vite consumes the UI build configuration default export; its source-map plugin is disabled for canonical source analysis.
  "ignoreIssues": {
    "packages/browser/*/src/**/*.stories.tsx": ["exports"],
    "packages/browser/elements/packages/**/*.stories.tsx": ["exports"],
    "packages/browser/elements/vite.config.ts": ["exports"],
  },
  // Each member's workspace follows from its kind and source roots, so a new member is checked like the others.
  // The published @mechane-ai/elements manifest defines its supported external API; its workspace checks private exports, unreachable files, and unused dependencies.
  "workspaces": {
    "packages/browser/catalog": { "project": ["src/**/*.{ts,tsx}!"] },
    // knip's Wrangler plugin reads `main` from wrangler.jsonc, the file the Workers runtime loads.
    "packages/browser/console": {
      "includeEntryExports": false,
      "entry": ["src/routes/**/*.tsx!", ".storybook/*.{ts,tsx}", "src/stories/**/*.stories.tsx"],
      "project": ["src/**/*.{ts,tsx,mdx}!", "worker-licenses.ts"],
    },
    "packages/browser/console-cache": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/browser/console-data": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/browser/console-views": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/browser/elements": {
      "includeEntryExports": false,
      "vite": false,
      "entry": ["vite.config.ts", ".storybook/*.{ts,tsx}", "packages/**/*.stories.tsx"],
      "project": ["packages/**/*.{ts,tsx,mdx}!"],
      "ignoreDependencies": ["@pierre/theme"],
    },
    "packages/node/boundaries": { "project": ["src/**/*.{ts,tsx}!"] },
    // A program exports nothing: its `src/main.ts`, and the `bin` its manifest names, are its entries.
    "packages/node/checks": { "entry": ["src/**/main.ts!"], "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/checks-kernel": { "project": ["src/**/*.{ts,tsx}!"] },
    // A program exports nothing: its `src/main.ts`, and the `bin` its manifest names, are its entries.
    "packages/node/cli": {
      "entry": ["src/**/main.ts!", "scripts/*/main.ts!"],
      "project": ["src/**/*.{ts,tsx}!", "scripts/**/*.{ts,tsx}!"],
    },
    "packages/node/cli-kernel": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/cli-login": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/cli-update": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/commands": { "project": ["src/**/*.{ts,tsx}!"] },
    // A program exports nothing: its `src/main.ts`, and the `bin` its manifest names, are its entries.
    "packages/node/distribution": { "entry": ["src/**/main.ts!"], "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/eval": { "project": ["src/**/*.{ts,tsx}!"] },
    // A program exports nothing: its `src/main.ts`, and the `bin` its manifest names, are its entries.
    "packages/node/guest": { "entry": ["src/**/main.ts!"], "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/locks": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/modules": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/normalizers": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/owned-rules": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/program": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/release": { "entry": ["src/**/main.ts!"], "project": ["src/**/*.{ts,tsx}!"] },
    // A program exports nothing: its `src/main.ts`, and the `bin` its manifest names, are its entries.
    "packages/node/rename": { "entry": ["src/**/main.ts!"], "project": ["src/**/*.{ts,tsx}!"] },
    // A program exports nothing: its `src/main.ts`, and the `bin` its manifest names, are its entries.
    "packages/node/rule-generator": { "entry": ["src/**/main.ts!"], "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/rule-shapes": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/rules": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/smoke": { "entry": ["src/**/main.ts!"], "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/stack": { "entry": ["src/**/main.ts!"], "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/testing": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/node/wrangler": { "entry": ["src/**/main.ts!"], "project": ["src/**/*.{ts,tsx}!"] },
    "packages/shared/client": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/shared/credentials": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/shared/deployment": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/shared/protocol": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/shared/records": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/shared/sandbox-wire": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/shared/utilities": { "project": ["src/**/*.{ts,tsx}!"] },
    // knip's Wrangler plugin reads `main` from wrangler.jsonc, the file the Workers runtime loads.
    "packages/worker/app": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/authentication": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/bindings": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/directory": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/directory-store": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/edge": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/harness": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/harness-tools": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/integrations": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/key-cache": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/limiter": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/limiter-store": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/logs": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/mech": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/mech-ports": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/mech-store": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/pages": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/rpc": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/sandbox": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/sandbox-store": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/store": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/workspace": { "project": ["src/**/*.{ts,tsx}!"] },
    "packages/worker/workspace-store": { "project": ["src/**/*.{ts,tsx}!"] },
  },
}
