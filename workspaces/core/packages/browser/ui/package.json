{
  "name": "@mechane-ai/ui",
  "version": "0.3.1",
  "description": "Mechane controls, content, AI interfaces, application layouts, and charts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mechane-ai/mechane.git",
    "directory": "workspaces/core/packages/browser/ui"
  },
  "files": [
    "dist",
    "packages/core/src/tokens.stylex.ts",
    "styles.css",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./packages/core/src/index.ts",
    "./tokens": "./packages/core/src/tokens.stylex.ts",
    "./tokens.stylex": "./packages/core/src/tokens.stylex.ts",
    "./layout": "./packages/layout/src/index.ts",
    "./collections": "./packages/collections/src/index.ts",
    "./content": "./packages/content/src/index.ts",
    "./content/code": "./packages/content/src/code/index.ts",
    "./content/diff": "./packages/content/src/diff/index.ts",
    "./content/tree": "./packages/content/src/tree/index.ts",
    "./ai": "./packages/ai/src/index.ts",
    "./charts": "./packages/charts/src/index.ts",
    "./charts/cartesian": "./packages/charts/src/cartesian/index.ts",
    "./charts/distribution": "./packages/charts/src/distribution/index.ts",
    "./charts/matrix": "./packages/charts/src/matrix/index.ts",
    "./charts/graph": "./packages/charts/src/graph/index.ts",
    "./styles.css": "./packages/core/src/styles.css",
    "./content/link": "./packages/content/src/link.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/packages/core/src/index.d.ts",
        "import": "./dist/index.js"
      },
      "./tokens": {
        "types": "./dist/packages/core/src/tokens.stylex.d.ts",
        "import": "./dist/tokens.js"
      },
      "./tokens.stylex": "./packages/core/src/tokens.stylex.ts",
      "./layout": {
        "types": "./dist/packages/layout/src/index.d.ts",
        "import": "./dist/layout.js"
      },
      "./collections": {
        "types": "./dist/packages/collections/src/index.d.ts",
        "import": "./dist/collections.js"
      },
      "./content": {
        "types": "./dist/packages/content/src/index.d.ts",
        "import": "./dist/content.js"
      },
      "./content/code": {
        "types": "./dist/packages/content/src/code/index.d.ts",
        "import": "./dist/content/code.js"
      },
      "./content/diff": {
        "types": "./dist/packages/content/src/diff/index.d.ts",
        "import": "./dist/content/diff.js"
      },
      "./content/tree": {
        "types": "./dist/packages/content/src/tree/index.d.ts",
        "import": "./dist/content/tree.js"
      },
      "./ai": {
        "types": "./dist/packages/ai/src/index.d.ts",
        "import": "./dist/ai.js"
      },
      "./charts": {
        "types": "./dist/packages/charts/src/index.d.ts",
        "import": "./dist/charts.js"
      },
      "./charts/cartesian": {
        "types": "./dist/packages/charts/src/cartesian/index.d.ts",
        "import": "./dist/charts/cartesian.js"
      },
      "./charts/distribution": {
        "types": "./dist/packages/charts/src/distribution/index.d.ts",
        "import": "./dist/charts/distribution.js"
      },
      "./charts/matrix": {
        "types": "./dist/packages/charts/src/matrix/index.d.ts",
        "import": "./dist/charts/matrix.js"
      },
      "./charts/graph": {
        "types": "./dist/packages/charts/src/graph/index.d.ts",
        "import": "./dist/charts/graph.js"
      },
      "./styles.css": "./styles.css",
      "./content/link": {
        "types": "./dist/packages/content/src/link.d.ts",
        "import": "./dist/content/link.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@daypicker/react": "10.0.2",
    "@pierre/diffs": "1.6.4",
    "@pierre/highlights": "0.4.0",
    "@pierre/theme": "1.1.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@shadcn/react": "0.3.1",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-hotkeys": "0.22.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@visx/hierarchy": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "lucide-react": "1.66.0",
    "react-resizable-panels": "4.18.0",
    "streamdown": "2.7.1",
    "strip-ansi": "7.2.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.5",
    "@stylexjs/unplugin": "0.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
