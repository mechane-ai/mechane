// Copy outside the checkout, then replace the names, domain, GitHub client and model offer.
// The deployment tool reads this installation file; Wrangler receives its rendered output.
{
  "name": "my-mechane",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "agents.example.invalid", "custom_domain": true }],
  "r2_buckets": [
    { "binding": "RELEASES", "bucket_name": "my-mechane-releases" },
    { "binding": "WORKSPACE_FILES", "bucket_name": "my-mechane-workspace-files" },
  ],
  "container": { "name": "my-mechane-sandboxes", "instance_type": "standard-1", "max_instances": 20 },
  "secret_refs": {
    "MECHANE_GITHUB_CLIENT_SECRET": "MECHANE_DEPLOY_GITHUB_CLIENT_SECRET",
    "MECHANE_MODEL_API_KEY": "MECHANE_DEPLOY_MODEL_API_KEY",
  },
  "limits": { "cpu_ms": 300000 },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1, "persist": true },
  },
  "vars": {
    "MECHANE_ORIGIN": "https://agents.example.invalid",
    "MECHANE_GITHUB_CLIENT_ID": "replace-with-your-github-oauth-client-id",
    // Replace both lists with verified GitHub numeric IDs before admitting users.
    "MECHANE_ALLOWED_IDENTITIES": "[]",
    "MECHANE_ADMINISTRATOR_IDENTITIES": "[]",
    "MECHANE_MODEL_UPSTREAM": "https://model-provider.example.invalid/v1",
    "MECHANE_MODEL_OFFERS": "[{\"id\":\"replace-with-your-model-id\",\"context_window_tokens\":32768,\"max_output_tokens\":8192,\"input_micros_per_million_tokens\":1000000,\"output_micros_per_million_tokens\":5000000,\"cache_read_micros_per_million_tokens\":1000000,\"cache_write_micros_per_million_tokens\":1000000}]",
    "MECHANE_SANDBOX_PROVIDER": "container",
    "MECHANE_SANDBOX_WORKSPACES": "*",
    "MECHANE_WORKSPACE_MACHINES": "4",
    "MECHANE_SUSPENDED_WORKSPACES": "[]",
    "MECHANE_DAILY_ALLOWANCE_MICROS": "20000000",
    "MECHANE_MECH_DAILY_CAP_MICROS": "10000000",
    "MECHANE_NAMED_KEY_LIFETIME_SECONDS": "31536000",
    "MECHANE_RATE_LIMITS": "{\"address\":{\"requests\":600,\"window_seconds\":60},\"device_start\":{\"requests\":10,\"window_seconds\":600},\"principal\":{\"requests\":300,\"window_seconds\":60},\"code_attempt\":{\"requests\":10,\"window_seconds\":600}}",
    "MECHANE_ALARM_WORK_SECONDS": "600",
  },
}
